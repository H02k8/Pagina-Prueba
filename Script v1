-- PARSER RAP CON SOPORTE PARA K, M, B
--------------------------------------------------------------------------------
local function parseRAP(str)
    if not str then return nil end
    local txt = tostring(str):gsub("<[^>]->", ""):upper()
    if not txt:find("RAP") then return nil end
    
    local numStr, multStr = txt:match("RAP%s*:%s*([%d%.,]+)%s*([KMB]?)")
    if not numStr then
        numStr, multStr = txt:match("([%d%.,]+)%s*([KMB]?)")
    end
    
    if numStr then
        local rawNum = numStr:gsub(",", "")
        local n = tonumber(rawNum)
        if n then
            local multiplicador = 1
            if multStr == "K" then multiplicador = 1000
            elseif multStr == "M" then multiplicador = 1000000
            elseif multStr == "B" then multiplicador = 1000000000
            end
            
            return math.floor(n * multiplicador)
        end
    end
    return nil
end

