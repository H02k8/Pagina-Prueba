--------------------------------------------------------------------------------
-- BUSCADOR MEJORADO DE NOMBRE DEL VEHÍCULO Y TOOLTIP
--------------------------------------------------------------------------------
local function obtenerInfoVehiculo(playerGui)
    local palabrasProhibidas = {
        "PAID", "AD", "RAP", "CLASS", "TOP SPEED", "HANDLING", 
        "DRIVETRAIN", "REWARD", "PER MILE", "ACQUIRED", "VIEW", 
        "PERFORMANCE", "COLLECTIONS", "COMPLETED", "SEASON", "INCOME", "CAR", "TOKENS",
        "MPH", "KM/H", "FWD", "RWD", "AWD", "$"
    }

    local valorRap = nil
    local rapElemEncontrado = nil
    local nombreVehiculo = nil

    -- 1. Intentar encontrar elemento con RAP primero
    for _, elem in pairs(playerGui:GetDescendants()) do
        if elem:IsA("TextLabel") and elem.Visible and not elem:IsDescendantOf(screenGui) then
            local parsed = parseRAP(elem.Text)
            if parsed then
                valorRap = parsed
                rapElemEncontrado = elem
                break
            end
        end
    end

    -- 2. Si encontramos el RAP, buscar el nombre en el mismo contenedor del tooltip
    if rapElemEncontrado and rapElemEncontrado.Parent then
        for _, child in pairs(rapElemEncontrado.Parent:GetChildren()) do
            if child:IsA("TextLabel") and child ~= rapElemEncontrado and child.Visible then
                local txt = child.Text:gsub("<[^>]->", ""):match("^%s*(.-)%s*$")
                local u = txt:upper()
                if #txt >= 2 and not u:find("CAR") and not u:find("TOKENS") and not u:find("RAP") and not tonumber(txt) then
                    nombreVehiculo = txt
                    break
                end
            end
        end
    end

    -- 3. Si no hay RAP o no leyó el nombre del tooltip, leer la cabecera del panel derecho
    if not nombreVehiculo then
        for _, elem in pairs(playerGui:GetDescendants()) do
            if elem:IsA("TextLabel") and elem.Visible and not elem:IsDescendantOf(screenGui) then
                if elem.Text:upper():find("TOP SPEED") and elem.Parent then
                    for _, child in pairs(elem.Parent:GetChildren()) do
                        if child:IsA("TextLabel") and child ~= elem and child.Visible then
                            local t = child.Text:gsub("<[^>]->", ""):match("^%s*(.-)%s*$")
                            local tUpper = t:upper()

                            local esValido = #t >= 2 and not tonumber(t)
                            for _, prohibida in ipairs(palabrasProhibidas) do
                                if tUpper:find(prohibida) then
                                    esValido = false
                                    break
                                end
                            end

                            if esValido then
                                nombreVehiculo = t
                                break
                            end
                        end
                    end
                end
            end
            if nombreVehiculo then break end
        end
    end

    return nombreVehiculo, valorRap
end

