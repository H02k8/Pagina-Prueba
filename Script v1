local autosProcesados = 0
local registrados = {}

local function enviarHTTP(params)
    local fn = request or http_request or (syn and syn.request) or (http and http.request)
    if not fn then 
        estadoValLabel.Text = " Error: Sin HttpRequest"
        estadoValLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
        return 
    end

    local query = "?"
    for k, v in pairs(params) do
        query = query .. k .. "=" .. HttpService:UrlEncode(tostring(v)) .. "&"
    end

    task.spawn(function()
        local response = fn({
            Url = API_URL .. query,
            Method = "GET"
        })
        
        if response then
            estadoValLabel.Text = " Guardado con éxito"
            estadoValLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
            
            autosProcesados = autosProcesados + 1
            contadorValLabel.Text = " " .. tostring(autosProcesados) .. " procesados"
        else
            estadoValLabel.Text = " Error al enviar"
            estadoValLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
        end
    end)
end

